# Port (Render, Railway, Heroku set this automatically)
PORT=5000

# Environment Mode
NODE_ENV=production

# MongoDB Database Connection String:
# Local: mongodb://localhost:27017/moneytracker
# Production (MongoDB Atlas Cloud):
# DATABASE_URL="mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/moneytracker?retryWrites=true&w=majority"
DATABASE_URL="mongodb+srv://your_db_user:your_db_password@cluster0.mongodb.net/moneytracker?retryWrites=true&w=majority"

# JWT Secret for Signing User Auth Tokens (use any secure 32+ character random string)
JWT_SECRET="your_strong_random_jwt_secret_key_here"

# Super Admin Dashboard Credentials (optional, defaults provided in code)
ADMIN_EMAIL="admin@gmail.com"
ADMIN_PASSKEY="admin1234"
