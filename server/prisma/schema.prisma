generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model User {
  id           String        @id @default(auto()) @map("_id") @db.ObjectId
  name         String
  email        String        @unique
  password     String
  currency     String        @default("₹")
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  friends      Friend[]
  transactions Transaction[]
}

model Friend {
  id              String        @id @default(auto()) @map("_id") @db.ObjectId
  userId          String        @db.ObjectId
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  name            String
  phone           String?
  email           String?
  avatarColor     String        @default("#6366f1")
  avatarEmoji     String        @default("👤")
  relationshipTag String        @default("Friend")
  notes           String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  transactions    Transaction[]
}

model Transaction {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  userId        String   @db.ObjectId
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  friendId      String   @db.ObjectId
  friend        Friend   @relation(fields: [friendId], references: [id], onDelete: Cascade)
  type          String   // "GIVEN", "RECEIVED", "SETTLED", "SPLIT"
  amount        Float
  impactOnUser  Float    // Positive (+) = Friend owes you, Negative (-) = You owe friend
  category      String   @default("Food & Dining")
  note          String
  date          String
  time          String?
  paymentMethod String   @default("UPI")
  status        String   @default("COMPLETED")
  receiptNote   String?
  splitGroupId  String?
  createdAt     DateTime @default(now())
}
